{
  "name": "@oneid/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Zod schemas, DTOs, enums and constants for ONEiD",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "pnpm exec eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "3.25.51"
  },
  "devDependencies": {
    "@oneid/eslint-config": "workspace:*",
    "@oneid/tsconfig": "workspace:*",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
